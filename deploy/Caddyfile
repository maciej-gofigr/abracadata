# Serves the SPA + prerendered SEO pages and reverse-proxies /api/* to the
# backend. The site address is DOMAIN from the compose environment; when DOMAIN
# is unset it falls back to `:80`, so Caddy serves plain HTTP on the box's raw
# IP with no cert — handy for smoke-testing on EC2 before DNS exists. Set DOMAIN
# to a real hostname and Caddy auto-provisions HTTPS. (No contact email by
# default; add a `{ email you@example.com }` global block for expiry notices.)
{$DOMAIN::80} {
	encode zstd gzip

	# Security headers. Recipes are LLM/shared-authored JS run via new Function in
	# a web worker; the worker also strips its own network primitives. `connect-src
	# 'self'` is the defense-in-depth that stops a malicious shared recipe from
	# exfiltrating the user's data to a third party. `script-src 'unsafe-eval'` is
	# required by the recipe runtime AND by Arquero (both compile via Function).
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# API — strip the /api prefix (backend routes are /generate, /recipes, …).
	handle_path /api/* {
		reverse_proxy backend:8000 {
			flush_interval -1  # stream SSE (/generate) without buffering
		}
	}

	# Static site: exact file, then a prerendered dir index (/t/{slug}/index.html,
	# /templates/index.html), else the SPA shell for client-side routes.
	handle {
		root * /srv
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
