# Copy to /opt/prestidata/.env on the box and fill in. Never commit the real one.

# --- Images (GHCR). IMAGE_REPO is ghcr.io/<your-gh-username-or-org> ---
IMAGE_REPO=ghcr.io/CHANGE_ME
IMAGE_TAG=latest

# --- Domain / TLS ---
# Leave DOMAIN BLANK to serve plain HTTP on the box's raw IP (no cert) — good for
# a first smoke test on EC2 before DNS exists. Set it to your hostname once DNS
# points at the box, and Caddy auto-provisions HTTPS. ACME_EMAIL is optional.
DOMAIN=
ACME_EMAIL=

# --- Postgres (on-box container; move to RDS later by changing DATABASE_URL) ---
POSTGRES_USER=prestidata
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_string
POSTGRES_DB=prestidata

# --- Bedrock: creds come from the EC2 instance role; only region + models here ---
AWS_REGION=us-east-2
BEDROCK_MODEL=global.anthropic.claude-sonnet-4-6
SUGGEST_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
