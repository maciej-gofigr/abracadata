# Backend environment — copy to `backend/.env` and fill in. `.env` is gitignored.
# Loaded by `make dev-local` and by docker-compose (env_file) for the backend service.

# Long-lived IAM credentials for Bedrock (IAM user scoped to bedrock:Invoke*/Converse*).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# Bedrock model (inference profile id). us.anthropic.claude-opus-4-6-v1 is the best
# Opus tier this account can reach today.
BEDROCK_MODEL=us.anthropic.claude-opus-4-6-v1

# Optional: return the login code in the /auth/request response for local testing.
# Leave unset in production (wire a real mailer instead).
# AUTH_DEV_ECHO=1

# Optional: skip Bedrock entirely and return a canned recipe.
# MOCK_GENERATE=1
