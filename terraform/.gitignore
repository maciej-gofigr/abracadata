# Local state can contain secrets — never commit it.
*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Your real variables (the .example is committed).
terraform.tfvars
*.auto.tfvars

# Saved plan files (binary; may embed resource values).
tfplan
*.tfplan

# Keep the provider lock file (.terraform.lock.hcl) committed for reproducible runs.
